        "validation": "required_for_all_functions",
        "violation_response": "mandatory_stop"
      },
      "I2_memory_isolation": {
        "rule": "explicit_memory_tracking_with_cleanup_contracts",
        "validation": "required_for_all_allocations",
        "violation_response": "mandatory_stop"
      },
      "I3_workspace_coherence": {
        "rule": "follow_defined_schema_patterns",
        "validation": "continuous_structure_checking",
        "violation_response": "mandatory_stop"
      },
      "I4_documentation_purity": {
        "rule": "json_first_with_derived_human_summaries",
        "validation": "documentation_format_checking",
        "violation_response": "mandatory_stop"
      }
    },
    
    "performance_contracts": {
      "response_latency": "max_5_seconds",
      "memory_usage": "ceiling_2gb",
      "concurrent_operations": "limit_10",
      "code_coverage": "minimum_85_percent",
      "complexity": "max_cyclomatic_10",
      "documentation_completeness": "100_percent"
