    {
      "tile_id": "tile.lang.guided_hallucinator",
      "tile_name": "Guided Hallucinator Tile",
      "capabilities": [
        "conversation.imagination",
        "conversation.response_proposal",
        "conversation.hypothesis"
      ],
      "inputs": [
        {
          "fact_type": "conversation.turn",
          "schema": "constraint_fact"
        },
        {
          "fact_type": "conversation.context_snapshot",
          "schema": "constraint_fact"
        }
      ],
      "outputs": [
        {
          "fact_type": "conversation.hypothesis",
          "schema": "constraint_fact"
        },
        {
          "fact_type": "conversation.self_assessment",
          "schema": "constraint_fact"
        }
      ],
      "behavior_guarantees": {
        "determinism_proof_hash": "hash://sha256/placeholder-guided-hallucinator",
        "accuracy_bounds": {
          "speculation_alignment": 0.75,
          "self_confidence_floor": 0.6
        },
        "failure_modes": [
          "upstream_context_missing",
          "model_seed_divergence"
        ]
      },
      "resource_budget": {
        "cpu_percent": 30,
        "memory_mb": 2048,
        "disk_mb": 512,
        "latency_p95_ms": 120
      },
      "runtime_contract": {
        "resource_constraints": {
          "max_concurrent_requests": 4,
          "max_prompt_tokens": 256,
          "max_completion_tokens": 480,
          "request_timeout_ms": 30000
        },
        "internal_state": {
          "counters": [
            {
              "name": "in_flight_counter",
              "type": "int",
              "description": "Tracks deterministic number of active TinyLLaMA calls"
            }
          ],
          "queues": [
            {
              "name": "request_queue",
              "capacity": 4,
              "policy": "bounded_fifo",
              "description": "Local backpressure queue when remote slots are saturated"
            }
          ]
        },
        "error_classification": {
          "context_size_exceeded": "terminal_refusal",
          "timeout": {
            "action": "retry_once_if_slot_available",
            "retry_delay_ms": 0
          },
          "local_queue_full": "structured_refusal"
        },
        "telemetry_signals": [
          "slot_contention_events",
          "timeout_expirations",
          "context_overflow_refusals",
          "queue_wait_duration_ms"
        ],
        "proof_chain_outputs": [
          "request_uuid",
          "prompt_tokens_actual",
          "completion_tokens_actual",
          "outcome",
          "dependency_evidence_refs"
        ],
        "dependency_evidence": [
          {
            "artifact": "models/server.logs/server.log1.md",
            "finding": "llama.cpp returns HTTP 500 with 'Context size has been exceeded' when four 512-token completions run concurrently"
          },
          {
            "artifact": "tmp/slot_full_with_slots.json",
            "finding": "Remote /slots endpoint lags and fails to report all busy workers under load"
          },
          {
            "artifact": "tmp/slot_full_with_slots_timeseries.json",
            "finding": "Repeated polling shows blind queuing plus probe timeouts at 10s when slots saturated"
          }
        ]
      },
      "presentation_manifest": {
        "preferred_views": [
          "imagination_trace",
          "confidence_meter"
        ],
        "data_bindings": {
          "hypothesis": "outputs[0].payload",
          "confidence": "outputs[1].payload.confidence",
          "governed_seed": "behavior_guarantees.determinism_proof_hash"
        },
        "narrative_template": "Tile {{tile_id}} proposed hypothesis '{{hypothesis.summary}}' (confidence {{confidence}})",
        "sensitivity_class": "internal"
      },
      "lifecycle_state": "proposed",
      "constraints_compliance": [
        "I1",
        "I2",
        "I3",
        "I4"
