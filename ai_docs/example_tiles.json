      "tile_id": "tile.lang.semantic_router",
      "tile_name": "Semantic Router Tile",
      "capabilities": [
        "language.route",
        "context.select"
      ],
      "inputs": [
        {
          "fact_type": "conversation.input",
          "schema": "constraint_fact"
        },
        {
          "fact_type": "conversation.turn",
          "schema": "constraint_fact"
        },
        {
          "fact_type": "cognition.sentiment_result",
          "schema": "constraint_fact"
        }
      ],
      "outputs": [
        {
          "fact_type": "conversation.route_decision",
          "schema": "constraint_fact"
        }
      ],
      "behavior_guarantees": {
        "determinism_proof_hash": "hash://sha256/placeholder",
        "accuracy_bounds": {
          "top_route_precision": 0.92
        },
        "failure_modes": [
          "low_confidence_route"
        ]
      },
      "resource_budget": {
        "cpu_percent": 12,
        "memory_mb": 384,
        "disk_mb": 64,
        "latency_p95_ms": 18
      },
      "presentation_manifest": {
        "preferred_views": [
          "text_summary",
          "causal_graph"
        ],
        "data_bindings": {
          "route_choice": "outputs[0].payload",
          "confidence": "behavior_guarantees.accuracy_bounds.top_route_precision"
        },
        "narrative_template": "Tile {{tile_id}} routed to {{route_choice}} with {{confidence}} confidence.",
        "sensitivity_class": "public"
      },
      "lifecycle_state": "promoted",
      "constraints_compliance": [
        "I1",
        "I2",
        "I3",
        "I4"
      ]
    },
